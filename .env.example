# 이 파일을 복사해서 같은 폴더에 ".env" 라는 이름으로 저장한 뒤 값을 채우세요.
# (.env는 비밀번호와 같으니 GitHub에 올리지 마세요. .gitignore에 이미 등록되어 있습니다.)

# 공공데이터포털 '기상청_단기예보 조회서비스' 인증키 (일반 인증키 Decoding 권장)
# 비워 두면 자동으로 테스트용 가짜 데이터로 실행됩니다.
KMA_SERVICE_KEY=

# true로 하면 API 키가 있어도 가짜 데이터로 실행
TEST_MODE=false

# 가짜 데이터 시나리오: rainy(오후 비 + 큰 일교차) / clear(맑음 + 일교차 작음)
MOCK_SCENARIO=rainy

# 기상청 격자 좌표 (기본: 서울 60, 127)
# 확인 방법: python weather_fetcher.py --grid <위도> <경도>
NX=60
NY=127
LOCATION_NAME=서울

# Discord 채널 설정 > 연동 > 웹후크 에서 복사한 URL
DISCORD_WEBHOOK_URL=

# 로컬 스케줄러 실행 시각 (PC 시계 기준, 24시간 형식)
BRIEFING_TIME=07:30
